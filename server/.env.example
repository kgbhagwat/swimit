PORT=4000
DATABASE_URL=postgresql://swimit:swimit@localhost:5432/swimit
# Production domain
CORS_ORIGIN=https://swimit.co.in
PUBLIC_APP_URL=https://swimit.co.in
# Number of trusted reverse proxies in front of the server (usually 1 in production).
# Correct proxy configuration is required for per-client login rate limits.
TRUST_PROXY_HOPS=1
# Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# WhatsApp Cloud API (Meta) — use a permanent System User token (not temporary API Setup token).
# See docs/whatsapp-permanent-token.md
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=swimit-whatsapp-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_OTP_TEMPLATE=swimit_signup_otp
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_ACCOUNT_READY_TEMPLATE=swimit_welcome
WHATSAPP_ACCOUNT_LOGIN_TEMPLATE=swimit_login_info
WHATSAPP_ACCOUNT_LOGIN_CREDS_TEMPLATE=swimit_login_creds

# SMTP — signup email OTP and temporary passwords (forgot password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# true on staging only — reuse pool account mobiles with a warning
ALLOW_DUPLICATE_ACCOUNT_MOBILE=false

# AES-256 key for birthdate + identity proof at rest (64-char hex OR any passphrase).
# Generate hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=
