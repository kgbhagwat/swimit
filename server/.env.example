PORT=4000
DATABASE_URL=postgresql://swimit:swimit@localhost:5432/swimit
# Production domain
CORS_ORIGIN=https://swimit.co.in
PUBLIC_APP_URL=https://swimit.co.in

# WhatsApp Cloud API (Meta) — use a permanent System User token (not temporary API Setup token).
# See docs/whatsapp-permanent-token.md
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=swimit-whatsapp-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# true on staging only — reuse pool account mobiles with a warning
ALLOW_DUPLICATE_ACCOUNT_MOBILE=false

# AES-256 key for birthdate + identity proof at rest (64-char hex OR any passphrase).
# Generate hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=
