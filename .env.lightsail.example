DOMAIN=staging.swimit.co.in
POSTGRES_USER=swimit
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=swimit
CORS_ORIGIN=https://staging.swimit.co.in
PUBLIC_APP_URL=https://staging.swimit.co.in

# WhatsApp Cloud API — use a permanent System User token (staging + prod).
# Temporary "Copy token" from API Setup expires → OAuthException code 190.
# Setup guide: docs/whatsapp-permanent-token.md
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=paste-permanent-system-user-token-here
WHATSAPP_PHONE_NUMBER_ID=paste-phone-number-id-here
WHATSAPP_VERIFY_TOKEN=swimit-whatsapp-verify
WHATSAPP_APP_SECRET=paste-app-secret-from-app-settings-basic
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Staging only: allow reuse of account mobile (shows warning). Leave false/unset on production.
ALLOW_DUPLICATE_ACCOUNT_MOBILE=true

# AES-256 key for birthdate + identity proof at rest (64-char hex OR any passphrase).
# Generate hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=change-me-to-a-long-random-secret-or-64-char-hex
