# Copy to .env on the Lightsail server and edit values.
#   cp .env.lightsail.example .env

# Public hostname for this instance (must already point DNS A record here)
DOMAIN=swimit.co.in

# Strong unique password — do not reuse across staging/prod
POSTGRES_USER=swimit
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=swimit

# Browser CORS — usually the same as https://DOMAIN
CORS_ORIGIN=https://swimit.co.in
