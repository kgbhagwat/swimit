# Production image that uses pre-built client/server dist (built on a PC / CI).
# Avoids running Vite on small Lightsail burstable instances (CPU credits → hang).
#
# On the server, after rsync of client/dist + server/dist:
#   APP_DOCKERFILE=Dockerfile.prebuilt bash scripts/lightsail-deploy.sh

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME

RUN apk add --no-cache font-dejavu

COPY package.json package-lock.json ./
COPY client/package.json ./client/
COPY server/package.json ./server/

RUN npm ci --omit=dev && npm cache clean --force

COPY server/dist ./server/dist
COPY client/dist ./client/dist
COPY scripts/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh \
  && mkdir -p /app/server/uploads \
  && chown -R node:node /app \
  && test -f /app/client/dist/index.html \
  && test -f /app/server/dist/index.js

USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/docker-entrypoint.sh"]
